{
  "name": "tasklist",
  "version": "1.0.0",
  "description": "常驻第二屏的个人任务清单管理软件",
  "main": "src/main.js",
  "author": "KehuiPang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KehuiPang/tasklist.git"
  },
  "homepage": "https://github.com/KehuiPang/tasklist#readme",
  "bugs": {
    "url": "https://github.com/KehuiPang/tasklist/issues"
  },
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/gen-tray.js",
    "dist": "electron-builder --win --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.wuwei.tasklist",
    "productName": "TaskList",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/tray-16.png",
      "build/tray-24.png",
      "build/tray-32.png",
      "build/winicon-16.png",
      "build/winicon-32.png",
      "build/winicon-48.png",
      "build/winicon-64.png",
      "build/winicon-128.png",
      "build/winicon-256.png",
      "build/winicon-512.png",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "KehuiPang <pangkehui4258@gmail.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "KehuiPang",
      "repo": "tasklist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TaskList"
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  }
}
